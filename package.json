{
  "name": "slicer-project-manager",
  "private": true,
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check",
    "verify": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test && pnpm test:rust && pnpm lint:rust"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
