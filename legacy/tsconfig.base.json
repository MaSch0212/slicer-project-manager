{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    /* No baseUrl: it is deprecated as of TypeScript 6 (which packages/web uses), and the
       mappings below resolve relative to this file without it. */
    "paths": {
      "@spm/contract": ["./packages/contract/src/index.ts"],
      "@spm/contract/*": ["./packages/contract/src/*"],
      "@spm/core": ["./packages/core/src/index.ts"]
    }
  }
}
