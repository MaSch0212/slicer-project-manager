{
  "workspace": ["./packages/contract", "./packages/core", "./packages/server", "./packages/web"],
  "imports": {
    "@spm/contract": "./packages/contract/src/index.ts",
    "@spm/contract/errors.ts": "./packages/contract/src/errors.ts",
    "@spm/contract/dtos.ts": "./packages/contract/src/dtos.ts",
    "@spm/contract/schemas.ts": "./packages/contract/src/schemas.ts",
    "@spm/contract/api-client.ts": "./packages/contract/src/api-client.ts",
    "@spm/core": "./packages/core/src/index.ts",
    "zod": "npm:zod@^4.0.0"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["npm:@awdlab/jig", "npm:@awdlab/jig-themes", "npm:@awdlab/jig-custom-types"]
  },
  "fmt": {
    "exclude": ["**"]
  },
  "lint": {
    "exclude": ["**"]
  },
  "tasks": {
    "install": "deno install --allow-scripts",
    "dev": "echo \"Run two terminals: deno task dev:ui  |  deno task dev:server\"",
    "dev:ui": "cd packages/web && node node_modules/@angular/cli/bin/ng.js serve --port 4200",
    "dev:server": "SPM_DEV_UI_ORIGIN=http://localhost:4200 SPM_LOG_LEVEL=debug deno run --env-file -A --watch --no-clear-screen packages/server/main.ts",
    "serve": "deno task build:ui && deno run --env-file -A packages/server/main.ts",
    "build:ui": "cd packages/web && node node_modules/@angular/cli/bin/ng.js build",
    "import": "deno run --env-file -A packages/server/import-curamanager.ts",
    "lint": "deno run -A node_modules/eslint/bin/eslint.js .",
    "fmt": "deno run -A node_modules/prettier/bin/prettier.cjs --write .",
    "fmt:check": "deno run -A node_modules/prettier/bin/prettier.cjs --check .",
    "typecheck": "deno task typecheck:contract && deno task typecheck:core && deno task typecheck:server && deno task typecheck:web",
    "typecheck:contract": "deno run -A node_modules/typescript/bin/tsc --noEmit -p packages/contract/tsconfig.json",
    "typecheck:core": "deno run -A node_modules/typescript/bin/tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck:server": "deno check packages/server/main.ts packages/server/import-curamanager.ts",
    "typecheck:web": "deno task typecheck:web:app && deno task typecheck:web:spec && deno task typecheck:web:e2e && deno task typecheck:web:seed",
    "typecheck:web:app": "cd packages/web && node node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p tsconfig.app.json --noEmit",
    "typecheck:web:spec": "cd packages/web && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.spec.json",
    "typecheck:web:e2e": "cd packages/web && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:web:seed": "deno check packages/web/e2e/seed.ts",
    "test:contract": "node --test \"packages/contract/test/**/*.test.ts\"",
    "test:core:node": "node --test \"packages/core/test/**/*.test.ts\"",
    "test:core:deno": "deno test --allow-read --allow-write --allow-env packages/core/test/",
    "test:server": "deno test --allow-all packages/server/test/",
    "test:web": "cd packages/web && node node_modules/@angular/cli/bin/ng.js test --no-watch",
    "e2e": "cd packages/web && node node_modules/@playwright/test/cli.js test",
    "verify": "deno task lint && deno task fmt:check && deno task typecheck && deno task test:contract && deno task test:core:node && deno task test:core:deno && deno task test:server && deno task test:web"
  }
}
