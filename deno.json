{
  "imports": {
    "@spm/contract": "./packages/contract/src/index.ts",
    "@spm/contract/errors.ts": "./packages/contract/src/errors.ts",
    "@spm/contract/dtos.ts": "./packages/contract/src/dtos.ts",
    "@spm/contract/schemas.ts": "./packages/contract/src/schemas.ts",
    "@spm/contract/api-client.ts": "./packages/contract/src/api-client.ts",
    "@spm/core": "./packages/core/src/index.ts",
    "zod": "npm:zod@^4.0.0"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": ["**"]
  },
  "lint": {
    "exclude": ["**"]
  },
  "tasks": {
    "dev": "echo \"Run two terminals: deno task dev:ui  |  deno task dev:server\"",
    "dev:ui": "cd packages/web && deno run -A node_modules/@angular/cli/bin/ng.js serve --port 4200",
    "dev:server": "SPM_DEV_UI_ORIGIN=http://localhost:4200 SPM_LOG_LEVEL=debug deno run -A packages/server/main.ts",
    "serve": "deno task build:ui && deno run -A packages/server/main.ts",
    "build:ui": "cd packages/web && deno run -A node_modules/@angular/cli/bin/ng.js build",
    "import": "deno run -A packages/server/import-curamanager.ts",
    "install": "pnpm install",
    "check": "pnpm typecheck",
    "lint": "pnpm lint",
    "fmt": "pnpm format",
    "test": "pnpm verify",
    "test:core": "deno test --allow-read --allow-write --allow-env packages/core/test/",
    "test:server": "deno test --allow-all packages/server/test/",
    "test:web": "cd packages/web && deno run -A node_modules/@angular/cli/bin/ng.js test --no-watch",
    "e2e": "pnpm e2e"
  }
}
