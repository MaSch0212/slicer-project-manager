/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.base.json",
  "compileOnSave": false,
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "importHelpers": true,
    /* Only @spm/web imports JSON (the i18n locale files): resolveJsonModule lives here, not
       in the shared base, since core and server never import JSON as a module. Also what
       makes `export type Translations = typeof en` catch a locale file missing a key at
       compile time. */
    "resolveJsonModule": true,
    "target": "ES2022",
    /* Pinned alongside target: the base config's ES2023 lib would let the compiler accept
       ES2023 methods (toSorted, findLast) that esbuild downlevels syntactically but does not
       polyfill, so they would fail in a browser that Angular's target still supports. */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* Angular/bundler resolution: relative imports here are extensionless, unlike core and
       server which resolve through Deno and must carry the .ts extension. */
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
