{
  // Rust: one Cargo workspace at the root. The desktop crate (apps/desktop/src-tauri) is a
  // member, so rust-analyzer needs no linkedProjects. Clippy on save matches `pnpm lint:rust`.
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.cargo.allTargets": true,

  // TypeScript and Solid (packages/web): the workspace's own TypeScript, not the editor's.
  "typescript.tsdk": "node_modules/typescript/lib",

  // Formatting is oxfmt (`pnpm fmt`), linting is oxlint (`pnpm lint`); rustfmt for Rust.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "[markdown]": { "editor.formatOnSave": false },

  "files.eol": "\n",
  "files.exclude": {
    "**/node_modules": true,
    "target": true
  },
  "search.exclude": {
    "**/dist": true,
    "target": true,
    "pnpm-lock.yaml": true,
    "Cargo.lock": true,
    "packages/web/src/api/generated": true
  }
}
