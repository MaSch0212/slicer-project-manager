{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slicer Project Manager",
  "version": "0.1.0",
  "identifier": "io.github.masch0212.slicer-project-manager",
  "mainBinaryName": "Slicer Project Manager",
  "build": {
    "frontendDist": "./shell",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @spm/web dev",
    "beforeBuildCommand": "pnpm --filter @spm/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Slicer Project Manager",
    "shortDescription": "Organise your 3D-printing projects",
    "copyright": "MIT",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "third-party/THIRD-PARTY-NOTICES.md",
      "../../../LICENSE": "third-party/LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
